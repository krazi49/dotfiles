configuration {
    show-icons: true;
    display-dmenu: "";
}

* {
    /* Tokyo Night Colors */
    bg: rgba(39, 43, 41, 0.70);
    bg-selected: #2f3549;
    fg: #c0caf5;
    accent: #7aa2f7;
    
    background-color: transparent;
    text-color: @fg;
}

window {
    width: 90%;
    height: 65%;
    background-color: rgba(39, 43, 41, 0.70);
    border: 2px;
    border-radius:  0;
    border-color: @accent;
    location: center;
    anchor: center;
}

mainbox {
    children: [ "inputbar", "listview" ];
    spacing: 20px;
    padding: 40px;
}

/* Search Bar Styling */
inputbar {
    background-color: rgba(39, 43, 41, 0.80);
    border-radius:  0;
    padding: 12px;
    children: [ "prompt", "entry" ];
    spacing: 10px;
}

prompt {
    font: "Hack Nerd Font 14";
}

entry {
    placeholder: "Search Wallpapers...";
    placeholder-color: #565f89;
    font: "Hack Nerd Font 12";
}

/* The Gallery View */
listview {
    layout: horizontal;
    spacing: 30px;
    lines: 5; /* This keeps ~5 cards visible */
    fixed-height: true;
    cycle: true;
}

element {
    width: 200px; /* Slimmer cards like the photo */
    height: 400px;
    orientation: vertical;
    border-radius:  0;
    padding: 10px;
    background-color: rgba(39, 43, 41, 0.60);
}

/* The "Middle One is longer/different" Effect */
element selected {
    background-color: @bg-selected;
    border: 3px;
    border-color: @accent;
    /* We add extra padding to selected to make it look "bigger" */
    padding: 20px 10px; 
    width: 320px; /* Highlighted card is wider */
}

element-icon {
    size: 450px; /* Large vertical size */
    horizontal-align: 0.5;
    expand: true;
}

element-text {
    horizontal-align: 0.5;
    font: "Hack Nerd Font 10";
    margin: 5px 0px;
}
