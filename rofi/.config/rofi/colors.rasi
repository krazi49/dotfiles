    secondary-fixed: #fbdcce;
    secondary-fixed-dim: #dec1b3;
    on-secondary: #ffffff;
    on-secondary-fixed: #28180f;
    on-secondary-fixed-variant: #574238;
    secondary-container: #fbdcce;
    on-secondary-container: #584439;
    tertiary: #655f33;
