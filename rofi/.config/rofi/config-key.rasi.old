/* style-key.rasi — converted from style-key.css (wider, monospace) */

@import "colors.rasi"

configuration {
    font:                   "Monaspace Neon NF 14";
    show-icons:             false;
}

* {
    font:                   "Monaspace Neon NF 14";
    text-color:             @on-surface;
    background-color:       transparent;
}

window {
    background-color:       transparent;
    border-radius:          36px;
    width:                  830px;
    height:                 600px;
    location:               north;
    y-offset:               0px;
    border:                 0px;
}

mainbox {
    background-color:       transparent;
    padding:                8px;
    spacing:                0px;
    children:               [ inputbar, listview-wrap ];
}

inputbar {
    background-color:       @surface-container-highest;
    text-color:             @on-surface;
    border-radius:          100px;
    padding:                14px 24px;
    margin:                 0px 12px 12px 12px;
    spacing:                8px;
    children:               [ prompt, entry ];
}

prompt {
    background-color:       transparent;
    text-color:             @primary;
    font:                   "Monaspace Neon NF Bold 18";
    expand:                 false;
    vertical-align:         0.5;
}

entry {
    background-color:       transparent;
    text-color:             @on-surface;
    font:                   "neonFlexsans 18";
    placeholder:            "";
    placeholder-color:      @on-surface-variant;
    cursor:                 text;
    
    /* THE FIX: Asymmetric padding to drop the search text down manually */
    padding:                3px 0px 0px 0px; 
}

/* ── Global Vertical Centering Rule ─────────────────────── */
/* Forcing internal engine layout wrappers to use a centered axis hook */
prompt, entry, element-text, element-icon {
    vertical-align:         0.5;
}

listview-wrap {
    background-color:       @surface-container;
    border-radius:          36px;
    padding:                10px;
    children:               [ listview ];
}

listview {
    background-color:       transparent;
    scrollbar:              false;
    spacing:                3px;
    lines:                  8;
    columns:                1;
    fixed-height:           false;
}

element {
    background-color:       transparent;
    text-color:             @on-surface;
    border-radius:          100px;
    padding:                11px 18px;
    border:                 1px solid transparent;
    spacing:                8px;
    orientation:            horizontal;
}

element selected {
    background-color:       @secondary-container;
    text-color:             @on-secondary-container;
    font:                   "Monaspace Neon NF SemiBold 14";
    
    /* THE FIX: Replicated padding shift logic for active highlight state uniformity */
    padding:                13px 18px 9px 18px; 
}

element normal active {
    text-color:             @primary;
    
    /* THE FIX: Replicated padding shift logic for active text state uniformity */
    padding:                13px 18px 9px 18px;
}

element-icon {
    background-color:       transparent;
    size:                   15px;
    vertical-align:         0.5;
}

element-text {
    background-color:       transparent;
    text-color:             inherit;
    vertical-align:         0.5;
    highlight:              bold @primary;
}

