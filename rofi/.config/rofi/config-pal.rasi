@import "colors.rasi"

configuration {
    font:                   "neonFlexsans 11";
    show-icons:             false;
    hover-select:           true;
    me-select-entry:        "";
    me-accept-entry:        "MousePrimary";
}

* {
    text-color:             @on-surface;
    background-color:       transparent;
}

window {
    background-color:       transparent;
    border-radius:          0;
    width:                  100%;
    location:               north;
    anchor:                 north;
    y-offset:               0;
    padding:                12px 14px 24px 14px;
    children:               [ mainbox ];
}

mainbox {
    orientation:            vertical;
    background-color:       transparent;
    padding:                0;
    spacing:                10px;
    children:               [ inputbar, listview ];
}

inputbar {
    background-color:       rgba(39, 43, 41, 0.70);
    text-color:             @on-surface;
    border-radius:          100px;
    padding:                8px 14px;
    margin:                 0 8px;
    spacing:                8px;
    children:               [ prompt, entry ];
}

prompt {
    text-color:             @primary;
    font:                   "neonFlexsans Bold 11";
    expand:                 false;
    vertical-align:         0.5;
}

entry {
    text-color:             @on-surface;
    font:                   "neonFlexsans 11";
    placeholder:            "Search...";
    placeholder-color:      @on-surface-variant;
    vertical-align:         0.5;
}

listview {
    layout:                 horizontal;
    background-color:       rgba(39, 43, 41, 0.70);
    border-radius:          100px;
    padding:                4px 6px;
    margin:                 0 8px;
    spacing:                4px;
    cycle:                  true;
    dynamic:                true;
    scrollbar:              false;
}

element {
    background-color:       transparent;
    text-color:             @on-surface;
    border-radius:          100px;
    padding:                6px 12px;
    spacing:                0;
    orientation:            horizontal;
}

element selected {
    background-color:       @secondary-container;
    text-color:             @on-secondary-container;
    padding:                6px 14px;
}

element normal active {
    text-color:             @primary;
}

element-text {
    text-color:             inherit;
    vertical-align:         0.5;
}
