/**
 * Matugen & Waybar Size-Matched Rofi Theme
 * Pure text implementation: entirely removes application icons and icon layouts.
 **/

@import "colors.rasi"

configuration {
    font:                   "TikTok Sans 10"; 
    show-icons:             false;                  /* Disables icon asset loading globally */
    display-drun:           "󰀻";
    display-run:            "󰆍";
    display-dmenu:          "";
    drun-display-format:    "{name}";
    hover-select:           true;
    me-select-entry:        "";
    me-accept-entry:        "MousePrimary";
}

* {
    text-color:             @on-surface;
    background-color:       transparent;
}

window {
    background-color:       @surface; /* lumina: solid surface, no glass */
    border:                 2px;
    border-color:           @outline-variant;
    border-radius:           0;
    width:                  96%;
    location:               north;
    y-offset:               6px;
    shadow:                 true;
    shadow-radius:           0;
    shadow-offset:           2px 2px;
    shadow-color:            @outline-variant;
    children:               [ mainbox ];
}

mainbox {
    orientation:            horizontal;
    background-color:       transparent;
    padding:                0px 14px 0px 6px;       
    spacing:                12px;
    children:               [ inputbar, listview ];
}

/* ── Search Input (Pill Block Container) ────────────────── */
inputbar {
    background-color:       @surface-container-highest;
    text-color:             @on-surface;
    border-radius:           0;
    border:                 2px;
    border-color:           @on-surface;
    /* ADJUSTED: Replaced 0px with 6px vertical padding to handle font baseline discrepancies */
    padding:                6px 14px;               
    margin:                 6px 0px;                
    spacing:                8px;
    children:               [ prompt, entry ];
}

prompt {
    text-color:             @primary;
    font:                   "TikTok Sans Bold 10";
    /* FIXED: Prevent the prompt from expanding vertically and force the baseline center */
    expand:                 false;
    vertical-align:         0.5;
}

entry {
    text-color:             @on-surface;
    font:                   "TikTok Sans 10";
    placeholder:            "Search...";
    placeholder-color:      @on-surface-variant;
    width:                  170px;                  

    /* THE FIX: Remove vertical-align and manually nudge it down */
    /* Syntax: TOP RIGHT BOTTOM LEFT */
}


/* ── Global Vertical Centering Rule ─────────────────────── */
/* This explicitly targets the underlying text layout engine for input elements */
prompt, entry, element-text {
    vertical-align:         0.5;
}

/* ── Page/Entry Counter Badge ───────────────────────────── */
num-filtered-rows {
    text-color:             @primary;
    font:                   "TikTok Sans SemiBold 10";
    vertical-align:         0.5;
}

textbox-num-sep {
    text-color:             @on-surface-variant;
    font:                   "TikTok Sans 10";
    expand:                 false;
    str:                    "/";                    
    vertical-align:         0.5;
}

num-total-rows {
    text-color:             @on-surface-variant;
    font:                   "TikTok Sans 10";
    vertical-align:         0.5;
}

/* ── Dynamic Horizontal List Grid ────────────────────────── */
listview {
    layout:                 horizontal;
    background-color:       transparent;
    scrollbar:              false;                  
    spacing:                8px;
    lines:                  100;                    
    columns:                1;
}

/* ── Pure Text Action Pills ─────────────────────────────── */
element {
    background-color:       transparent;
    text-color:             @on-surface;
    border-radius:           0;
    /* ADJUSTED: Match the vertical padding layout of the inputbar precisely */
    padding:                6px 14px;               
    margin:                 6px 0px;                
    spacing:                0px;
    orientation:            horizontal;
    
    /* Explicitly limits node children to text contents only */
    children:               [ element-text ];
}

element-text {
    text-color:             inherit;
    vertical-align:         0.5;                    
}

element selected {
    background-color:       @secondary-container;    
    text-color:             @on-secondary-container;
    border-color:           @outline-variant;
    border:                 2px; 
}

element normal active {
    text-color:             @primary;
    padding:                3px 0px 0px 3px;
}

