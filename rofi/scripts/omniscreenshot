#!/bin/bash
paplay ~/.sounds/omniscript.wav &
THEME="$HOME/.config/rofi/config.rasi"
export PATH="$HOME/.npm-global/bin:$PATH"
take_screenshot() {
  local tmpfile
  tmpfile=$(mktemp --suffix=.png)
  trap "rm -f $tmpfile" EXIT HUP INT TERM
  local choice=$(printf "󰒉  region → annotate (satty)\n󰒉  region → clipboard\n󰹑  fullscreen\n󰖲  active window" | rofi -dmenu \
    -theme "$THEME" \
    -p "${PROMPT:-screenshot}")
  [[ -z "$choice" ]] && exit 0
  sleep 0.5
  case "$choice" in
  *"region → annotate"*)
    # one-key region shot straight into satty for markup, save on exit
    grim -g "$(slurp)" - | satty -f - --save-to "$HOME/Pictures/Screenshots/screenshot_$(date +%Y%m%d_%H%M%S).png" &
    trap - EXIT
    return
    ;;
  *"region → clipboard"*)
    grim -g "$(slurp)" - | wl-copy
    notify-send "Screenshot" "region copied to clipboard" -t 2000
    trap - EXIT
    return
    ;;
  *"fullscreen"*)
    grim "$tmpfile"
    ;;
  *"window"*)
    local geom=$(hyprctl activewindow -j | jq -r '"\(.at[0]),\(.at[1]) \(.size[0])x\(.size[1])"')
    grim -g "$geom" "$tmpfile"
    ;;
  esac
  [[ ! -s "$tmpfile" ]] && exit 0
  local post_choice=$(printf "󰳻  save to file\n󰅏  copy to clipboard\n󰣕  open in satty" | rofi -dmenu \
    -theme "$THEME" \
    -p "action:")
  [[ -z "$post_choice" ]] && exit 0
  case "$post_choice" in
  *"save to file"*)
    mkdir -p "$HOME/Pictures/Screenshots"
    local default_filename="screenshot_$(date +%Y%m%d_%H%M%S).png"
    local save_path=$(rofi -dmenu -theme "$THEME" -p "save as:" -initial-selection "$HOME/Pictures/Screenshots/$default_filename")
    [[ -z "$save_path" ]] && exit 0
    mv "$tmpfile" "$save_path"
    trap - EXIT
    notify-send "Screenshot" "saved to $save_path" -t 2000
    ;;
  *"copy to clipboard"*)
    wl-copy <"$tmpfile"
    notify-send "Screenshot" "copied to clipboard" -t 2000
    ;;
  *"open in satty"*)
    trap - EXIT HUP INT TERM
    satty -f "$tmpfile" &
    ;;
  esac
}
take_screenshot
