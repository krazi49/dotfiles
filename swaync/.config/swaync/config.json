{
  "$schema": "/etc/xdg/swaync/configSchema.json",
  "positionX": "center",
  "positionY": "bottom",
  "control-center-positionX": "left",
  "control-center-positionY": "none",
  "control-center-margin-top": 8,
  "control-center-margin-bottom": 7,
  "control-center-margin-right": 12,
  "control-center-margin-left": 8,
  "control-center-width": 400,
  "control-center-height": -1,
  "fit-to-screen": false,
  "layer-shell-cover-screen": true,
  "layer-shell": true,
  "layer": "overlay",
  "control-center-layer": "overlay",
  "cssPriority": "user",
  "notification-icon-size": 32,
  "notification-body-image-height": 100,
  "notification-body-image-width": 200,
  "notification-inline-replies": true,
  "timeout": 6,
  "timeout-low": 5,
  "timeout-critical": 0,
  "notification-window-width": 300,
  "keyboard-shortcuts": true,
  "image-visibility": "when-available",
  "transition-time": 250,
  "hide-on-clear": true,
  "hide-on-action": false,
  "script-fail-notify": true,
  "widgets": [
    "buttons-grid#top",
    "buttons-grid#compact",
    "mpris",
    "backlight",
    "volume",
    "title",
    "notifications"
  ],
  "widget-config": {
    "title": {
      "text": "Recently missed",
      "clear-all-button": true,
      "button-text": "Clear all"
    },
    "buttons-grid#top": {
      "buttons-per-row": 2,
      "actions": [
        {
          "label": "󰤨   Wi-Fi",
          "type": "toggle",
          "active": false,
          "command": "sh -c '[[ $SWAYNC_TOGGLE_STATE == true ]] && nmcli radio wifi on || nmcli radio wifi off'",
          "update-command": "sh -c '[[ $(nmcli radio wifi) == \"enabled\" ]] && echo true || echo false'"
        },
        {
          "label": "󰂯   Bluetooth",
          "type": "normal",
          "active": false,
          "command": "blueberry"
        },
        {
          "label": "󰴽   Communications",
          "type": "toggle",
          "active": false,
          "command": "sh -c '[[ $SWAYNC_TOGGLE_STATE == false ]] && rfkill block all || rfkill unblock all'",
          "update-command": "sh -c 'rfkill list all | grep -q \"yes\" && echo false || echo true'"
        },
        {
          "label": "󰑊   Screen record",
          "type": "toggle",
          "active": false,
          "command": "gsr-ui"
        }
      ]
    },
    "buttons-grid#compact": {
      "buttons-per-row": 4,
      "actions": [
        {
          "label": "󰝟",
          "type": "toggle",
          "active": false,
          "command": "swaync-client -d -sw",
          "update-command": "sh -c 'swaync-client -D && echo true || echo false'"
        },
        {
          "label": "󰝩",
          "type": "toggle",
          "active": false,
          "active-color": "#5b615c",
          "command": "sh -c 'pgrep hyprsunset && pkill hyprsunset || hyprsunset -t 2600'",
          "update-command": "sh -c 'pgrep hyprsunset && echo true || echo false'"
        },
        {
          "label": "󰝟",
          "type": "toggle",
          "active": false,
          "command": "sh -c '[[ $SWAYNC_TOGGLE_STATE == true ]] && pactl set-sink-mute @DEFAULT_SINK@ 1 || pactl set-sink-mute @DEFAULT_SINK@ 0'",
          "update-command": "sh -c 'pactl get-sink-mute @DEFAULT_SINK@ | grep -q \"yes\" && echo true || echo false'"
        },
        {
          "label": "󰄀",
          "type": "normal",
          "active": false,
          "command": "bash ~/.config/rofi/scripts/omniscreenshot"
        },
        {
          "label": "󰌾",
          "type": "normal",
          "active": false,
          "command": "hyprlock"
        }
      ]
    },
    "notifications": {
      "vexpand": true
    },
    "inhibitors": {
      "text": "Inhibitors",
      "button-text": "Clear all",
      "clear-all-button": true
    },
    "mpris": {
      "autohide": true,
      "image-size": 86,
      "image-radius": 12
    },
    "backlight": {
      "label": "󰳲",
      "device": "intel_backlight",
      "subcommand": "brightnessctl"
    },
    "volume": {
      "label": "󰖀"
    }
  }
}
