{
  "layer": "top",
  "position": "bottom",
  "width": 0,
  "margin-left": 10,
  "margin-right": 10,
  "margin-bottom": 4,
  "margin-top": 0,
  "spacing": 4,
  "tooltips": true,
  "fixed-center": true,
  "start_hidden": false,

  "modules-left": [
    "custom/adaptive",
    "custom/clock",
    "custom/space"
  ],

  "modules-center": [
  ],

  "modules-right": [
    "custom/mood",
    "tray",
    "group/system"
  ],

  "group/system": {
    "orientation": "horizontal",
    "modules": [
      "custom/bt-battery",
      "network",
      "pulseaudio",
      "backlight"
    ],
    "on-click": "swaync-client -t -sw"
  },

  "custom/adaptive": {
    "interval": 0.1,
    "format": "{}",
    "rotate": 0,
    "tooltip": true,
    "exec": "~/.config/waybar/scripts/adaptive.py",
    "return-type": "json",
    "signal": 8,
    "on-click": "~/.config/waybar/scripts/adaptive.py --play-pause",
    "on-click-right": "~/.config/waybar/scripts/adaptive.py --next",
    "on-scroll-up": "~/.config/waybar/scripts/adaptive.py --seek-forward",
    "on-scroll-down": "~/.config/waybar/scripts/adaptive.py --seek-back"
  },

"custom/clock": {
    "exec": "~/.config/waybar/scripts/clock.sh",
    "return-type": "json",
    "rotate": 0,
    "markup": true,
    "escape": false,
    "on-click": "bash -c 'yad --calendar --title=\"Calendar\" --width=320 --height=280 --posx=200 --posy=30 --button=gtk-close:1 --close-on-unfocus'"
},

  "custom/space": {
    "tooltip": true,
    "format": "{text}",
    "rotate": 0,
    "exec": "~/.config/hypr/scripts/workspace.sh",
    "escape": false,
    "return-type": "json",
    "on-click": "bash ~/.config/hypr/scripts/workspace-overview.sh",
    "on-click-right": "bash ~/.config/hypr/scripts/workspace-jump.sh",
    "on-scroll-up": "bash ~/.config/hypr/scripts/workspace-scroll.sh e+1",
    "on-scroll-down": "bash ~/.config/hypr/scripts/workspace-scroll.sh e-1"
  },

  "custom/mood": {
    "interval": 10,
    "format": "{}",
    "rotate": 0,
    "tooltip": false,
    "exec-if": "[ -f ~/.config/waybar/current_mood ]",
    "exec": "~/.config/waybar/scripts/mood.sh",
    "return-type": "json"
  },

  "custom/bt-battery": {
    "interval": 10,
    "format": " {} ",
    "rotate": 0,
    "exec": "~/.config/waybar/scripts/bt-status.py",
    "return-type": "json",
    "on-click": "blueberry"
  },

  "network": {
    "tooltip": true,
    "tooltip-format": "Network: <big><b>{essid}</b></big>\nSignal strength: <b>{signaldBm}dBm ({signalStrength}%)</b>\nFrequency: <b>{frequency}MHz</b>\nInterface: <b>{ifname}</b>\nIP: <b>{ipaddr}/{cidr}</b>\nGateway: <b>{gwaddr}</b>\nNetmask: <b>{netmask}</b>",
    "format-linked": "{icon}",
    "format-wifi": "{icon}",
    "rotate": 0,
    "on-click": "nmgui",
    "format-ethernet": "{icon}",
    "format-disconnected": "{icon}",
    "interval": 2,
    "format-icons": [
      "󰤯",
      "󰤟",
      "󰤢",
      "󰤥",
      "󰤨"
    ]
  },

  "pulseaudio": {
    "format": "{icon}",
    "rotate": 0,
    "on-click": "pavucontrol",
    "format-muted": "{icon}",
    "format-icons": {
      "default": [
        "󰕿",
        "󰖀",
        "󰕾"
      ]
    },
    "tooltip-format": "Volume: {volume}%"
  },

  "backlight": {
    "format": "{icon}",
    "rotate": 0,
    "format-icons": [
      "󰃞",
      "󰃟",
      "󰃠"
    ],
    "tooltip-format": "Brightness: {percent}%"
  },

  "tray": {
    "icon-size": 12,
    "spacing": 6
  }
}
