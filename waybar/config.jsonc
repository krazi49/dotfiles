[
  {
    "layer": "top",
    "position": "bottom",
    "height": 24,
    "margin-top": 0,
    "margin-bottom": 5,
    "margin-left": 10,
    "margin-right": 10,
    "spacing": 10,
    "fixed-center": false,
    "modules-left": [
      "custom/space",
      "custom/adaptive",
      "custom/adaptive-extra"
    ],
    "modules-center": [],
    "modules-right": [
      "custom/clock",
      "custom/updates",
      "hyprland/submap"
    ],
    "tooltip": true,
    "custom/space": {
      "tooltip": true,
      "format": "{text}",
      "exec": "~/.config/hypr/scripts/workspace.sh",
      "escape": false,
      "return-type": "json",
      "on-click": "bash ~/.config/hypr/scripts/workspace-overview.sh",
      "on-click-right": "bash ~/.config/hypr/scripts/workspace-jump.sh",
      "on-scroll-up": "bash ~/.config/hypr/scripts/workspace-scroll.sh e+1",
      "on-scroll-down": "bash ~/.config/hypr/scripts/workspace-scroll.sh e-1"
    },
    "hyprland/submap": {
      "format": "{}",
      "tooltip": true
    },
    "group/system": {
      "orientation": "vertical",
      "modules": [
        "network",
        "pulseaudio",
        "backlight"
      ],
      "on-click": "swaync-client -t -sw"
    },
    "custom/adaptive": {
      "interval": 0.1,
      "format": "{}",
      "rotate": 0,
      "tooltip": true,
      "exec": "~/.config/waybar/scripts/adaptive.py",
      "return-type": "json",
      "signal": 8,
      "on-click": "~/.config/waybar/scripts/adaptive.py --play-pause",
      "on-click-right": "~/.config/waybar/scripts/adaptive.py --next",
      "on-scroll-up": "~/.config/waybar/scripts/adaptive.py --seek-forward",
      "on-scroll-down": "~/.config/waybar/scripts/adaptive.py --seek-back"
    },
    "custom/adaptive-extra": {
      "interval": 0.5,
      "format": "{}",
      "rotate": 0,
      "tooltip": true,
      "exec": "~/.config/waybar/scripts/adaptive.py --extra",
      "return-type": "json",
      "signal": 8,
      "on-click": "swaync-client -t -sw",
      "on-click-right": "swaync-client -d -sw"
    },
    "custom/clock": {
      "exec": "~/.config/waybar/scripts/clock.sh",
      "return-type": "json",
      "markup": true,
      "escape": false,
      "on-click": "yad --calendar --title=Calendar --width=320 --height=280 --posx=200 --posy=30 --button=gtk-close:1 --close-on-unfocus"
    },
    "custom/updates": {
      "interval": 300,
      "format": "{}",
      "font": "Monaspace Argon",
      "exec": "python3 ~/.config/waybar/scripts/updates.py",
      "return-type": "json",
      "tooltip": true,
      "on-click": "kitty -e sh -c 'checkupdates && yay -Qu --aur'",
      "on-click-right": "bash -c 'yay -Syu'"
    },
    "custom/bt-battery": {
      "interval": 10,
      "format": "{}",
      "exec": "~/.config/waybar/scripts/bt-status.py",
      "return-type": "json",
      "on-click": "blueberry"
    },
    "network": {
      "tooltip": true,
      "tooltip-format": "Network: <b>{essid}</b>\nSignal strength: <b>{signaldBm}dBm ({signalStrength}%)</b>\nFrequency: <b>{frequency}MHz</b>\nInterface: <b>{ifname}</b>\nIP: <b>{ipaddr}/{cidr}</b>\nGateway: <b>{gwaddr}</b>\nNetmask: <b>{netmask}</b>",
      "format-linked": "{icon}",
      "format-wifi": "{icon}",
      "on-click": "nmgui",
      "format-ethernet": "{icon}",
      "format-disconnected": "{icon}",
      "interval": 2,
      "format-icons": [
        "\udb82\udd2f",
        "\udb82\udd1f",
        "\udb82\udd22",
        "\udb82\udd25",
        "\udb82\udd28"
      ]
    },
    "pulseaudio": {
      "format": "{icon}",
      "on-click": "pavucontrol",
      "format-muted": "{icon}",
      "format-icons": {
        "default": [
          "\udb81\udd7f",
          "\udb81\udd80",
          "\udb81\udd7e"
        ]
      },
      "tooltip-format": "Volume: {volume}%"
    },
    "backlight": {
      "format": "{icon}",
      "format-icons": [
        "\udb80\udcde",
        "\udb80\udcdf",
        "\udb80\udce0"
      ],
      "tooltip-format": "Brightness: {percent}%"
    }
  },
  {
    "layer": "top",
    "position": "left",
    "width": 46,
    "margin-top": 0,
    "margin-bottom": 4,
    "margin-left": 10,
    "margin-right": 0,
    "spacing": 6,
    "fixed-center": false,
    "modules-left": [
      "wlr/taskbar",
      "group/system",
      "tray"
    ],
    "tooltip": true,
    "group/system": {
      "orientation": "vertical",
      "modules": [
        "network",
        "pulseaudio",
        "backlight"
      ],
      "on-click": "swaync-client -t -sw"
    },
    "pulseaudio": {
      "format": "{icon}",
      "on-click": "pavucontrol",
      "format-muted": "{icon}",
      "format-icons": {
        "default": [
          "\udb81\udd7f",
          "\udb81\udd80",
          "\udb81\udd7e"
        ]
      },
      "tooltip-format": "Volume: {volume}%"
    },
    "backlight": {
      "format": "{icon}",
      "format-icons": [
        "\udb80\udcde",
        "\udb80\udcdf",
        "\udb80\udce0"
      ],
      "tooltip-format": "Brightness: {percent}%"
    },
    "network": {
      "tooltip": true,
      "tooltip-format": "Network: <b>{essid}</b>\nSignal strength: <b>{signaldBm}dBm ({signalStrength}%)</b>\nFrequency: <b>{frequency}MHz</b>\nInterface: <b>{ifname}</b>\nIP: <b>{ipaddr}/{cidr}</b>\nGateway: <b>{gwaddr}</b>\nNetmask: <b>{netmask}</b>",
      "format-linked": "{icon}",
      "format-wifi": "{icon}",
      "on-click": "nmgui",
      "format-ethernet": "{icon}",
      "format-disconnected": "{icon}",
      "interval": 2,
      "format-icons": [
        "\udb82\udd2f",
        "\udb82\udd1f",
        "\udb82\udd22",
        "\udb82\udd25",
        "\udb82\udd28"
      ]
    },
    "tray": {
      "icon-size": 13,
      "spacing": 10
    },
    "wlr/taskbar": {
      "format": "{icon}",
      "icon-size": 22,
      "icon-theme": "Papirus",
      "tooltip-format": "{title}",
      "on-click": "activate",
      "on-click-middle": "close",
      "on-click-right": "minimize",
      "all-outputs": false,
      "active-first": false
    }
  }
]
